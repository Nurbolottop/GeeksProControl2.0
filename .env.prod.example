# GeeksPro Control 2.0 — сервер, /opt/geekspro2/.env (chmod 600).
# Все значения — новые, ни одно не берётся из .env версии 1.0.
COMPOSE_PROJECT_NAME=geekspro2
# Тестовый деплой: stage. Здесь своя БД с синтетическими данными, данные 1.0
# не переносятся, рассылка всем (TELEGRAM_OUTBOUND_MODE=on) запрещена.
# production — только по разрешению руководителя после финальной миграции
# (docs/migration-plan.md).
GP2_ENVIRONMENT=stage

# Порт на 127.0.0.1 хоста, его проксирует nginx. 1.0 занимает 8087.
WEB_PORT=8100

# python3 -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=CHANGE_ME

# Первым — основной домен: его использует healthcheck контейнера.
ALLOWED_HOSTS=gpro.zeastudio.su
CSRF_TRUSTED_ORIGINS=https://gpro.zeastudio.su
SITE_URL=https://gpro.zeastudio.su

LANGUAGE_CODE=ru
TIME_ZONE=Asia/Bishkek
LOG_LEVEL=INFO
# Подпись напоминаний ПМ («<имя> просит обновить этап»)
STAGE_REMINDER_FROM=Руководитель
GUNICORN_WORKERS=2

POSTGRES_DB=geekspro2
POSTGRES_USER=geekspro2
# python3 -c "import secrets; print(secrets.token_urlsafe(32))"
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_HOST=db
POSTGRES_PORT=5432

REDIS_URL=redis://redis:6379/0

SESSION_COOKIE_NAME=gp2_sessionid
CSRF_COOKIE_NAME=gp2_csrftoken

# Файлы media отдаёт nginx из internal-location (см. deploy/nginx).
MEDIA_ACCEL_REDIRECT_PREFIX=/protected-media/

# Администратора на сервере создают вручную:
#   scripts/gp2-compose.sh --prod exec web python manage.py createsuperuser
DJANGO_SUPERUSER_USERNAME=
DJANGO_SUPERUSER_PASSWORD=
DJANGO_SUPERUSER_EMAIL=

# --- Telegram -----------------------------------------------------------------
# Собственный бот 2.0. Токен бота 1.0 здесь запрещён (см. PROTECTED_VALUE_HASHES).
TELEGRAM_BOT_TOKEN=
# Username бота без «@» (не секрет). Тестовый бот 2.0: GeeksProAutoBot
TELEGRAM_BOT_USERNAME=GeeksProAutoBot
# На stage — off или allowlist (on запрещён проверкой gp2.E003).
TELEGRAM_OUTBOUND_MODE=off
TELEGRAM_TEST_CHAT_IDS=
# Тестовые группы (id супергрупп вида -100…): только в них бот пишет и создаёт темы
TELEGRAM_TEST_GROUP_IDS=
# Если до Telegram нет прямого маршрута: socks5h://host.docker.internal:<порт>
TELEGRAM_PROXY_URL=

# --- Google Sheets ------------------------------------------------------------
# Ключ кладётся в /opt/geekspro2/secrets/ и монтируется отдельно, в образ не
# попадает. Таблица — собственная таблица 2.0, не рабочая таблица 1.0.
GOOGLE_SHEETS_CREDENTIALS_FILE=
RESERVE_SHEET_ID=
RESERVE_SHEET_TAB=

IMPORT_DATA_DIR=/app/data

# SHA-256 токена бота 1.0 и ID таблицы 1.0, через запятую.
PROTECTED_VALUE_HASHES=

# --- Отдел продаж (этап 8A): группа и сотрудники, чьи «#оплата» принимаются. Пусто — не принимаются.
SALES_TELEGRAM_CHAT_ID=
# тема «Новые стажёры» в группе продаж — туда бот шлёт карточки регистраций (пусто — General)
SALES_NEW_INTERNS_THREAD_ID=
SALES_AGENT_TELEGRAM_IDS=

# --- Видеособрания (этап 9–10). simulator — без сети; jaas — только после проверки консоли.
VIDEO_PROVIDER=simulator
VIDEO_SIMULATOR_SECRET=
JAAS_APP_ID=
JAAS_KEY_ID=
# Путь к приватному ключу ВНЕ репозитория, права 600 (иначе gp2.E010 / W011)
JAAS_PRIVATE_KEY_PATH=
JAAS_WEBHOOK_SECRET=
# Release-gate: 1 — только после практической проверки, что вход без JWT запрещён
JAAS_ANONYMOUS_BLOCKED_VERIFIED=
