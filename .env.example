# GeeksPro Control 2.0 — локальная разработка.
# Скопируйте в .env и заполните. Никогда не копируйте .env из 1.0.
COMPOSE_PROJECT_NAME=geekspro2
# development | stage | production (production — только после финальной миграции)
GP2_ENVIRONMENT=development

WEB_PORT=8100
DB_PORT=5447
REDIS_PORT=6393

# python3 -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=CHANGE_ME
ALLOWED_HOSTS=127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8100,http://localhost:8100
SITE_URL=http://127.0.0.1:8100

LANGUAGE_CODE=ru
TIME_ZONE=Asia/Bishkek
LOG_LEVEL=INFO
# Подпись напоминаний ПМ («<имя> просит обновить этап»)
STAGE_REMINDER_FROM=Руководитель

# Отдельная тестовая база 2.0 — не база 1.0.
POSTGRES_DB=geekspro2_dev
POSTGRES_USER=geekspro2
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_HOST=db
POSTGRES_PORT=5432

REDIS_URL=redis://redis:6379/0

SESSION_COOKIE_NAME=gp2_sessionid
CSRF_COOKIE_NAME=gp2_csrftoken

# Администратор для локальной базы (создаётся при первом старте web).
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_PASSWORD=CHANGE_ME
DJANGO_SUPERUSER_EMAIL=admin@example.com

# --- Telegram -----------------------------------------------------------------
# Только ТЕСТОВЫЙ бот 2.0 (@BotFather → /newbot). Пусто — бот не запускается.
TELEGRAM_BOT_TOKEN=
# Username бота без «@» (не секрет). Тестовый бот 2.0: GeeksProAutoBot
TELEGRAM_BOT_USERNAME=GeeksProAutoBot
# off — никому не пишем (сообщения в лог); allowlist — только чатам ниже.
TELEGRAM_OUTBOUND_MODE=off
# Свои тестовые chat_id через запятую (не стажёры).
TELEGRAM_TEST_CHAT_IDS=
# Тестовые группы (id супергрупп вида -100…): только в них бот пишет и создаёт темы
TELEGRAM_TEST_GROUP_IDS=
TELEGRAM_PROXY_URL=

# --- Google Sheets ------------------------------------------------------------
# Только тестовая таблица и тестовый сервисный аккаунт. Пусто — выгрузка выключена.
GOOGLE_SHEETS_CREDENTIALS_FILE=
RESERVE_SHEET_ID=
RESERVE_SHEET_TAB=

# --- Импорт Excel -------------------------------------------------------------
# Каталог с xlsx для import_people (вне Git и Docker-образа).
IMPORT_DATA_DIR=/app/data

# --- Защита от значений 1.0 ---------------------------------------------------
# SHA-256 токена бота 1.0 и ID таблицы 1.0 через запятую (не сами значения):
#   printf '%s' "<значение>" | shasum -a 256
PROTECTED_VALUE_HASHES=

# --- Отдел продаж (этап 8A): группа и сотрудники, чьи «#оплата» принимаются. Пусто — не принимаются.
SALES_TELEGRAM_CHAT_ID=
SALES_AGENT_TELEGRAM_IDS=

# --- Видеособрания (этап 9–10). simulator — без сети; jaas — только после проверки консоли.
VIDEO_PROVIDER=simulator
VIDEO_SIMULATOR_SECRET=
JAAS_APP_ID=
JAAS_KEY_ID=
# Путь к приватному ключу ВНЕ репозитория, права 600 (иначе gp2.E010 / W011)
JAAS_PRIVATE_KEY_PATH=
JAAS_WEBHOOK_SECRET=
# Release-gate: 1 — только после практической проверки, что вход без JWT запрещён
JAAS_ANONYMOUS_BLOCKED_VERIFIED=
